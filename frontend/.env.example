# 前端环境变量配置模板
# 复制此文件为 .env 并根据需要修改

# 后端API基础地址配置
# 支持以下格式：
# 1. 具体IP地址: VITE_API_BASE_URL=http://192.168.1.100:8000
# 2. 自动检测: VITE_API_BASE_URL=auto
# 3. 本地开发: VITE_API_BASE_URL=http://127.0.0.1:8000
# 4. 留空: 系统会自动检测

# 局域网访问配置（根据你的网络环境修改）
VITE_API_BASE_URL=http://192.168.12.109:8000

# 其他配置
VITE_APP_TITLE=NovelForge
VITE_APP_VERSION=0.8.2